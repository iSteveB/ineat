generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Budget {
  id          String    @id
  userId      String
  amount      Float
  periodStart DateTime
  periodEnd   DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  User        User      @relation(fields: [userId], references: [id])
  Expense     Expense[]

  @@index([periodStart, periodEnd])
  @@index([userId])
}

model Category {
  id             String     @id
  name           String
  parentId       String?
  icon           String?
  slug           String     @unique
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")
  Product        Product[]
}

model Expense {
  id            String       @id
  userId        String
  budgetId      String
  amount        Float
  date          DateTime
  source        String?
  receiptId     String?
  invoiceId     String?
  invoiceItemId String?      @unique
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  category      String?
  Budget        Budget       @relation(fields: [budgetId], references: [id])
  Invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  InvoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  User          User         @relation(fields: [userId], references: [id])

  @@index([budgetId])
  @@index([category])
  @@index([date])
  @@index([invoiceId])
  @@index([userId])
}

model InventoryItem {
  id                String             @id
  userId            String
  productId         String
  quantity          Float
  expiryDate        DateTime?
  expiryDateSource  ExpiryDateSource   @default(MANUAL)
  packageStatus     PackageStatus?
  preparationStatus PreparationStatus?
  purchaseDate      DateTime
  purchasePrice     Float?
  storageLocation   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  notes             String?
  Product           Product            @relation(fields: [productId], references: [id])
  User              User               @relation(fields: [userId], references: [id])

  @@index([expiryDate])
  @@index([productId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, expiryDate])
  @@index([userId, storageLocation])
  @@index([userId, productId, storageLocation, expiryDate])
}

enum ExpiryDateSource {
  MANUAL
  ESTIMATED
}

enum PackageStatus {
  UNOPENED
  OPENED
}

enum PreparationStatus {
  RAW
  COOKED
}

model Notification {
  id                String                 @id
  userId            String
  type              NotificationType
  title             String
  message           String
  isRead            Boolean                @default(false)
  referenceId       String?
  referenceType     String?
  deduplicationKey  String                 @unique @db.VarChar(32)
  dismissedAt       DateTime?
  resolvedAt        DateTime?
  lastOccurredAt    DateTime               @default(now())
  occurrenceVersion Int                    @default(1)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime
  User              User                   @relation(fields: [userId], references: [id])
  deliveries        NotificationDelivery[]

  @@index([isRead])
  @@index([type])
  @@index([userId])
  @@index([userId, resolvedAt, dismissedAt])
}

model NotificationDelivery {
  id                String                     @id
  notificationId    String
  channel           NotificationChannel
  occurrenceVersion Int
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                        @default(0)
  providerMessageId String?
  errorMessage      String?
  nextAttemptAt     DateTime?
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime
  Notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel, occurrenceVersion])
  @@index([status, nextAttemptAt])
}

model NotificationPreferences {
  userId              String   @id
  inAppEnabled        Boolean  @default(true)
  emailEnabled        Boolean  @default(false)
  pushEnabled         Boolean  @default(false)
  weeklyDigestEnabled Boolean  @default(true)
  dailyDigestEnabled  Boolean  @default(false)
  expiry              Boolean  @default(true)
  budget              Boolean  @default(true)
  system              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  User                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailDigestDelivery {
  id                String    @id
  userId            String
  type              String
  periodKey         String
  status            String    @default("PENDING")
  attemptCount      Int       @default(0)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  User              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, periodKey])
  @@index([status, updatedAt])
  @@index([userId])
}

model Product {
  id               String             @id
  barcode          String?            @unique
  name             String
  brand            String?
  categoryId       String
  nutriscore       NutriScore?
  ecoscore         Ecoscore?
  novascore        Novascore?
  unitType         UnitType
  nutrients        Json?
  imageUrl         String?
  externalId       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  ingredients      String?
  InventoryItem    InventoryItem[]
  InvoiceItem      InvoiceItem[]
  Category         Category           @relation(fields: [categoryId], references: [id])
  ReceiptItem      ReceiptItem[]
  RecipeIngredient RecipeIngredient[]

  @@index([brand])
  @@index([name])
}

model Invoice {
  id                  String                   @id
  userId              String
  pdfUrl              String
  status              InvoiceStatus            @default(PROCESSING)
  processingStage     InvoiceProcessingStage   @default(UPLOADED)
  processingProgress  Int                      @default(10)
  processingAttempt   Int                      @default(1)
  stageStartedAt      DateTime?
  stageCompletedAt    DateTime?
  processingErrorCode String?
  rawAnalysisData     Json?
  merchantName        String?
  totalAmount         Float?
  purchaseDate        DateTime?
  invoiceNumber       String?
  orderNumber         String?
  analysisProvider    String?
  analysisConfidence  Float?
  processingTime      Int?
  errorMessage        String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime
  Expense             Expense[]
  InvoiceItem         InvoiceItem[]
  ProcessingEvent     InvoiceProcessingEvent[]
  User                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([purchaseDate])
  @@index([status])
  @@index([processingStage])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, purchaseDate])
  @@index([userId, totalAmount])
}

model InvoiceProcessingEvent {
  id          String                       @id
  invoiceId   String
  stage       InvoiceProcessingStage
  status      InvoiceProcessingEventStatus
  attempt     Int                          @default(1)
  startedAt   DateTime
  completedAt DateTime?
  durationMs  Int?
  errorCode   String?
  createdAt   DateTime                     @default(now())
  Invoice     Invoice                      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@index([stage, status])
}

model InvoiceItem {
  id                      String    @id
  invoiceId               String
  productId               String?
  detectedName            String
  quantity                Float     @default(1)
  unitPrice               Float?
  totalPrice              Float?
  confidence              Float
  validated               Boolean   @default(false)
  productCode             String?
  category                String?
  discount                Float?
  selectedEan             String?
  suggestedEans           Json      @default("[]")
  externalProductProvider String?
  externalProductStatus   String?
  externalProductData     Json?
  externalProductError    String?
  expiryDate              DateTime?
  storageLocation         String?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime
  Expense                 Expense?
  Invoice                 Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  Product                 Product?  @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([externalProductStatus])
  @@index([productCode])
  @@index([productId])
  @@index([validated])
}

model Receipt {
  id               String        @id
  userId           String
  documentType     DocumentType  @default(RECEIPT_IMAGE)
  imageUrl         String?
  pdfUrl           String?
  status           ReceiptStatus @default(PROCESSING)
  rawOcrData       Json?
  merchantName     String?
  totalAmount      Float?
  purchaseDate     DateTime?
  invoiceNumber    String?
  orderNumber      String?
  ocrProvider      String?
  ocrConfidence    Float?
  processingTime   Int?
  errorMessage     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  merchantAddress  String?
  merchantLocation String?
  User             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ReceiptItem      ReceiptItem[]

  @@index([createdAt])
  @@index([documentType])
  @@index([purchaseDate])
  @@index([status])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, purchaseDate])
  @@index([userId, totalAmount])
}

model ReceiptItem {
  id              String    @id
  receiptId       String
  productId       String?
  detectedName    String
  quantity        Int       @default(1)
  unitPrice       Float?
  totalPrice      Float?
  confidence      Float
  validated       Boolean   @default(false)
  productCode     String?
  category        String?
  discount        Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  expiryDate      DateTime?
  notes           String?
  storageLocation String?
  selectedEan     String?
  suggestedEans   Json      @default("[]")
  Product         Product?  @relation(fields: [productId], references: [id])
  Receipt         Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([productCode])
  @@index([productId])
  @@index([receiptId])
  @@index([validated])
}

model Recipe {
  id                 String             @id
  userId             String?
  name               String
  description        String?
  instructions       String
  preparationTime    Int?
  cookingTime        Int?
  servings           Int
  difficulty         RecipeDifficulty
  imageUrl           String?
  type               RecipeType         @default(MAIN)
  source             RecipeSource       @default(MANUAL)
  basicIngredients   Json               @default("[]")
  missingIngredients Json               @default("[]")
  steps              Json               @default("[]")
  doneAt             DateTime?
  isFavorite         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  RecipeIngredient   RecipeIngredient[]
  User               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([userId, isFavorite])
}

model RecipeIngredient {
  id        String                 @id
  recipeId  String
  productId String?
  name      String
  quantity  Float?
  unit      String
  notes     String?
  source    RecipeIngredientSource @default(INVENTORY)
  Product   Product?               @relation(fields: [productId], references: [id])
  Recipe    Recipe                 @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([recipeId])
  @@index([source])
}

model User {
  id                           String                   @id
  email                        String                   @unique
  name                         String
  emailVerified                Boolean                  @default(false)
  welcomeEmailSentAt           DateTime?
  firstName                    String                   @default("")
  lastName                     String                   @default("")
  defaultServings              Int                      @default(4)
  primaryGoal                  PrimaryGoal?
  profileOnboardingCompletedAt DateTime?
  preferences                  Json                     @default("{}")
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime
  role                         UserRole                 @default(USER)
  accountStatus                AccountStatus            @default(ACTIVE)
  accountStatusChangedAt       DateTime?
  suspendedUntil               DateTime?
  moderationReason             String?
  deletionScheduledAt          DateTime?
  statusBeforeDeletion         AccountStatus?
  subscriptionPlan             SubscriptionPlan         @default(FREE)
  subscriptionStatus           SubscriptionStatus       @default(ACTIVE)
  trialStartedAt               DateTime?
  trialEndsAt                  DateTime?
  trialUsedAt                  DateTime?
  trialStartedEmailSentAt      DateTime?
  trialReminderEmailSentAt     DateTime?
  trialExpiredEmailSentAt      DateTime?
  currentPeriodStartedAt       DateTime?
  currentPeriodEndsAt          DateTime?
  stripeCustomerId             String?                  @unique
  stripeSubscriptionId         String?                  @unique
  stripePriceId                String?
  billingInterval              BillingInterval?
  cancelAtPeriodEnd            Boolean                  @default(false)
  subscriptionCancelledAt      DateTime?
  lastStripeEventAt            DateTime?
  avatarUrl                    String?
  Budget                       Budget[]
  Expense                      Expense[]
  EmailDigestDelivery          EmailDigestDelivery[]
  InventoryItem                InventoryItem[]
  Invoice                      Invoice[]
  Notification                 Notification[]
  NotificationPreferences      NotificationPreferences?
  Recipe                       Recipe[]
  Receipt                      Receipt[]
  UsageQuota                   UsageQuota[]
  UsageEvent                   UsageEvent[]
  sessions                     Session[]
  accounts                     Account[]
  AdminAuditLog                AdminAuditLog[]          @relation("AdminAuditActor")

  @@map("User")
  @@index([accountStatus])
  @@index([deletionScheduledAt])
}

model AdminAuditLog {
  id            String   @id
  adminUserId   String
  action        String
  resourceType  String
  resourceId    String
  previousValue Json?
  newValue      Json?
  reason        String
  ipAddress     String?
  sessionId     String?
  createdAt     DateTime @default(now())
  AdminUser     User     @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model StripeWebhookEvent {
  id            String    @id
  stripeEventId String    @unique
  type          String
  status        String
  errorMessage  String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status])
  @@index([type])
}

model ResendWebhookEvent {
  id           String   @id
  type         String
  emailId      String?
  emailType    String?
  recipientRef String?
  eventAt      DateTime
  processedAt  DateTime @default(now())

  @@index([type, eventAt])
}

model EmailSuppression {
  recipientRef String   @id
  reason       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UsageQuota {
  id                 String    @id
  userId             String
  usageType          UsageType
  periodStart        DateTime
  periodEnd          DateTime
  usedCount          Int       @default(0)
  limit              Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  warningEmailSentAt DateTime?
  reachedEmailSentAt DateTime?
  User               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageType, periodStart, periodEnd])
  @@index([periodEnd])
  @@index([usageType])
  @@index([userId])
}

model UsageEvent {
  id         String    @id
  userId     String
  usageType  UsageType
  occurredAt DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([usageType, occurredAt])
  @@index([userId, occurredAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum DocumentType {
  RECEIPT_IMAGE
  INVOICE_PDF
  INVOICE_HTML
}

enum Ecoscore {
  A
  B
  C
  D
  E
}

enum InvoiceStatus {
  PROCESSING
  COMPLETED
  FAILED
  VALIDATED
}

enum InvoiceProcessingStage {
  UPLOADED
  QUEUED
  EXTRACTING
  ANALYZING
  NORMALIZING
  ENRICHING
  READY_FOR_REVIEW
  FAILED
  VALIDATED
}

enum InvoiceProcessingEventStatus {
  STARTED
  COMPLETED
  FAILED
}

enum NotificationType {
  EXPIRY
  BUDGET
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SUPPRESSED
  SKIPPED
}

enum Novascore {
  GROUP_1
  GROUP_2
  GROUP_3
  GROUP_4
}

enum NutriScore {
  A
  B
  C
  D
  E
}

enum PrimaryGoal {
  REDUCE_WASTE
  SAVE_MONEY
  EAT_BETTER
  FIND_MEAL_IDEAS
}

enum ReceiptStatus {
  PROCESSING
  COMPLETED
  FAILED
  VALIDATED
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

enum RecipeIngredientSource {
  INVENTORY
  BASIC
  MISSING
}

enum RecipeSource {
  AI
  MANUAL
}

enum RecipeType {
  STARTER
  MAIN
  DESSERT
}

enum SubscriptionPlan {
  FREE
  TRIAL
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum UnitType {
  KG
  G
  L
  ML
  UNIT
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
  ANONYMIZED
}

enum UsageType {
  AI_RECIPE_GENERATION
  DRIVE_IMPORT
}
