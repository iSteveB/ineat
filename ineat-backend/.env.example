# InEat backend environment example
# Copy this file to .env.development for local development.
# In production, configure these values in the hosting provider, for example Railway.

# Runtime
NODE_ENV=development
PORT=3000
NOTIFICATION_SYNC_INTERVAL_MS=3600000
# legacy keeps the in-process timer; bullmq enables scheduled notification workers.
NOTIFICATION_SCHEDULER_MODE=legacy
NOTIFICATION_DELIVERY_MODE=legacy
NOTIFICATION_WORKER_CONCURRENCY=5

# Queue monitoring thresholds used by GET /admin/queues.
QUEUE_WARNING_BACKLOG=100
QUEUE_CRITICAL_BACKLOG=1000
QUEUE_WARNING_LAG_MS=300000
QUEUE_CRITICAL_LAG_MS=1800000
QUEUE_WARNING_FAILURES_PER_HOUR=5
QUEUE_CRITICAL_FAILURES_PER_HOUR=20

# Database
# Required by Prisma v7 during install/build/generate and at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ineat

# Queue (required in production; provision a Redis service on Railway)
REDIS_URL=redis://localhost:6379
# Keep environments isolated. Defaults to ineat:<NODE_ENV>:
REDIS_KEY_PREFIX=ineat:development
# Admin audit logs: 365 days by default (CNIL recommendation: 6-12 months)
ADMIN_AUDIT_RETENTION_DAYS=365

# Auth
# Use long random values in real environments.
BETTER_AUTH_SECRET=replace-with-a-long-random-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000

# CORS
# The canonical production frontend is https://ineat.store.
# These variables can add one or more origins (comma-separated) when needed.
FRONTEND_URL=https://ineat.store
CORS_ORIGIN=https://ineat.store

# Transactional email (Resend)
# Leave EMAIL_ENABLED=false locally to use fakes in automated tests.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Optional safety guard for non-production environments (comma-separated).
EMAIL_ALLOWED_RECIPIENTS=
# Created when https://api.ineat.store/email/webhook is registered in Resend.
RESEND_WEBHOOK_SECRET=

# Cloudinary
# Required for avatar uploads.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_AVATAR_PRESET=replace-with-avatar-upload-preset

# Invoice Drive import analysis
# Use mock locally unless you want to call OpenAI for real PDF extraction.
INVOICE_ANALYSIS_PROVIDER=mock
# BullMQ is the production-like default. Use sync only for focused local debugging.
INVOICE_PROCESSING_MODE=bullmq
INVOICE_WORKER_CONCURRENCY=2
OPENAI_API_KEY_INVOICE=
OPENAI_INVOICE_MODEL=gpt-5.5
OPENFOODFACTS_TIMEOUT_MS=5000
OPENFOODFACTS_CACHE_TTL_SECONDS=2592000
OPENFOODFACTS_NEGATIVE_CACHE_TTL_SECONDS=21600
OPENFOODFACTS_CONCURRENCY=4

# Stripe billing
# Keep Price IDs backend-only. The frontend sends MONTHLY or YEARLY, never a Price ID.
# Product to create in Stripe test/live: InEat Premium.
# Catalog prices:
# - premium_monthly_eur: 599 cents EUR / month, tax-inclusive public price 5.99 EUR TTC
# - premium_yearly_eur: 5999 cents EUR / year, tax-inclusive public price 59.99 EUR TTC
# Enable Stripe locally only when all Stripe values below are configured.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_PREMIUM_MONTHLY_EUR=
STRIPE_PRICE_PREMIUM_YEARLY_EUR=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=

# Sentry observability
# Optional; leave SENTRY_DSN empty to disable Sentry locally.
SENTRY_DSN=
SENTRY_ENABLE_LOGS=true
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=false
